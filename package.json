{
  "name": "ps2stk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.engine.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:reference": "python3 scripts/reference-check.py",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "card": "node --import tsx scripts/card.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
